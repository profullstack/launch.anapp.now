# Public origin of this microsite (canonical URL, OG tags).
SITE_ORIGIN=https://launch.anapp.now

# Where ideas and events are handed off. Chovy's campaign API lives in the
# chovy-ai repo under /api/campaign/*.
CHOVY_ORIGIN=https://chovy.com
# Shared secret; the same value must be set as CAMPAIGN_SECRET on the Chovy service.
CHOVY_CAMPAIGN_SECRET=change-me

# Hero creative experiment. Allocation is read per request, so changing this
# variable on Railway takes effect on restart without a code deploy.
EXPERIMENT_ID=launch_hero_creative_v1
HERO_ALLOCATION=hero_control:25,hero_fish_builder:25,hero_phone_rocket:25,hero_fish_no_code:25
